@{
    ViewData["Title"] = "Home Page";
}
@model List<URL>

@if (User.Identity?.IsAuthenticated == true)
{
    <app-root></app-root>
}
else
{
    <div class="alert alert-info text-center mt-2">
        You must log in before shortening URLs.
    </div>
}

@section Scripts
{
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script type="module"
                src="~/angular/browser/main.js"
                asp-append-version="true">
        </script>
    }
}